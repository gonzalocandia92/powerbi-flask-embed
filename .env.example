# Example Environment Variables for Power BI Flask Embed with MCP Integration

# ==========================================
# FLASK CONFIGURATION
# ==========================================
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
LOG_LEVEL=INFO
# Set to the exact number of trusted reverse proxies in front of Flask.
TRUSTED_PROXY_HOPS=1

# ==========================================
# DATABASE
# ==========================================
SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/powerbi_flask_db

# ==========================================
# AZURE AD / SERVICE PRINCIPAL (for Power BI API)
# ==========================================
CLIENT_ID=your-app-registration-id
CLIENT_SECRET=your-app-secret
TENANT_ID=your-tenant-id

# ==========================================
# ENCRYPTION KEY (for storing sensitive data)
# ==========================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ==========================================
# MCP SERVER CONFIGURATION
# ==========================================
# Local stdio MCP configuration used by the Flask chat service.
JWT_SECRET=your-jwt-secret-key-for-mcp-tokens

# OAuth Authorization Server and remote MCP resource server.
MCP_OAUTH_ISSUER=https://app.example.com
# Must exactly match MCP_PUBLIC_URL after removing a trailing slash.
MCP_RESOURCE_URL=https://mcp.example.com/mcp
MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Enable only after applying the DCR database migration.
MCP_OAUTH_DCR_ENABLED=false
# Optional comma-separated additions. MCP_PUBLIC_URL contributes its own host/origin.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com,https://chatgpt.com
# Use either the PEM value (literal newlines or escaped \n) or a mounted file.
# MCP_OAUTH_PRIVATE_KEY takes precedence when both are configured.
MCP_OAUTH_PRIVATE_KEY=
MCP_OAUTH_PRIVATE_KEY_FILE=/run/secrets/mcp-oauth-private.pem
MCP_OAUTH_ACCESS_TOKEN_TTL=900
MCP_OAUTH_REFRESH_TOKEN_TTL=2592000

# Internal Flask-to-MCP broker authentication.
# Compose uses a private network plus short-lived service JWTs, so mTLS is off.
# Set this to true only when MCP_BROKER_URL points through an mTLS proxy.
MCP_INTERNAL_JWT_SECRET=replace-with-at-least-32-random-bytes
MCP_INTERNAL_REQUIRE_MTLS=false
MCP_BROKER_URL=http://localhost:2052
# Optional Compose override when broker traffic goes through an mTLS proxy.
MCP_BROKER_URL_DOCKER=
MCP_SERVICE_ID=mcp-aklara
MCP_ENABLE_LEGACY_API_KEYS=true
MCP_INTERNAL_CLIENT_CERT=
MCP_INTERNAL_CLIENT_KEY=

# Host ports consumed by the external HTTPS reverse proxy.
FLASK_HOST_PORT=2052
MCP_HOST_PORT=8000
# Local Nginx gateway consumed by ngrok.
GATEWAY_HOST_PORT=8080

# Temporary credentials used only by the legacy API-key MCP route.
# They can be removed after MCP_ENABLE_LEGACY_API_KEYS is set to false.
POWERBI_CLIENT_ID=your-legacy-app-registration-id
POWERBI_CLIENT_SECRET=your-legacy-app-secret
POWERBI_TENANT_ID=your-legacy-tenant-id
MCP_API_KEY=

# Local/single-process default. In multi-instance production, point this to a
# shared Redis deployment, for example redis://redis.example.internal:6379/2.
RATELIMIT_STORAGE_URI=memory://

# Local Power BI MCP server (stdio)
# Run from the project root with:
#   python run.py
# and set these variables so Flask can launch the MCP subprocess.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-u server.py
MCP_SERVER_CWD=./mcp
MCP_SERVER_ENV_JSON={}

# Optional alternate names supported by the local stdio MCP server:
# CLIENT_ID_MCP=your-app-registration-id
# CLIENT_SECRET_MCP=your-app-secret

# ==========================================
# OPTIONAL: POWER BI SETTINGS
# ==========================================
# Refresh monitoring interval (hours)
REFRESH_POLL_INTERVAL_HOURS=12

# ==========================================
# OPTIONAL: KLARA AI / SKILL ROUTER
# ==========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional providers registered through the KLARA model catalog. Keys remain
# in environment/secrets and must never be stored in ai_model_configs.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_EVALUATION_POLL_SECONDS=3
OPENROUTER_API_KEY=
VOYAGE_API_KEY=your-voyage-api-key
TYPESAFE_API_KEY=
SKILL_ROUTER_ENABLED=false
SKILL_ROUTER_MODE=shadow
SKILL_ROUTER_CANDIDATE_LIMIT=8
SKILL_ROUTER_MAX_SELECTED_SKILLS=2
SKILL_ROUTER_RERANK_ENABLED=false
SKILL_ROUTER_SELECTOR_ENABLED=false
SKILL_ROUTER_SELECTOR_MODE=shadow
SKILL_ROUTER_SELECTOR_MODEL=claude-haiku-4-5-20251001
SKILL_ROUTER_SELECTOR_CANDIDATE_LIMIT=10
SKILL_ROUTER_SELECTOR_CONFIDENCE_THRESHOLD=0.70
SKILL_ROUTER_JEV_MODEL=jev-latest
SKILL_ROUTER_JEV_THRESHOLD=0.60
SKILL_ROUTER_JEV_NO_MATCH_THRESHOLD=0.60
SKILL_ROUTER_JEV_TIMEOUT_SECONDS=10

# ==========================================
# OPTIONAL: GEOIP DATABASE (for analytics)
# ==========================================
GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb
